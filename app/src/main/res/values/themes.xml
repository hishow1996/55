<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <!-- White startup/launch background -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Android 12+ (API 31+) System Splash Screen -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/elephant_line</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">#FFFFFF</item>
    </style>
</resources>
